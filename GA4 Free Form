const INDUSTRIES = ['All', ...Array.from(new Set(TEMPLATES.map(t=>t.industry)))];
let activeIndustry='All';

function renderIndustryNav(){
  const nav = document.getElementById('industryNav');
  nav.innerHTML='';
  INDUSTRIES.forEach(ind=>{
    const b=document.createElement('div');
    b.className='ind-btn'+(ind===activeIndustry?' active':'');
    b.textContent=ind;
    b.onclick=()=>{ activeIndustry=ind; renderIndustryNav(); renderTemplates(); };
    nav.appendChild(b);
  });
}

function renderTemplates(){
  const grid = document.getElementById('tplGrid');
  grid.innerHTML='';
  const list = activeIndustry==='All' ? TEMPLATES : TEMPLATES.filter(t=>t.industry===activeIndustry);
  list.forEach((t)=>{
    const idx = TEMPLATES.indexOf(t);
    const card = document.createElement('div'); card.className='tpl-card';
    const mini = [...t.dims.map(id=>dimMap[id].name), ...t.mets.map(id=>metMap[id].name)];
    card.innerHTML = '<div class="tpl-tag">'+t.industry+'</div><h3>'+t.title+'</h3><p class="q">'+t.q+'</p><div class="tpl-mini">'+mini.map(m=>'<span>'+m+'</span>').join('')+'</div>';
    card.onclick=()=>openTemplate(idx);
    grid.appendChild(card);
  });
}

function scopeDot(scope){ return '<i style="background:'+SCOPE_COLOR[scope]+'"></i>'; }

function openTemplate(idx){
  const t = TEMPLATES[idx];
  const detail = document.getElementById('tplDetail');
  detail.classList.add('open');
  const dimsHtml = t.dims.map(id=>'<div class="item">'+scopeDot(dimMap[id].scope)+dimMap[id].name+'</div>').join('');
  const metsHtml = t.mets.map(id=>'<div class="item">'+scopeDot(metMap[id].scope)+metMap[id].name+'</div>').join('');
  const segHtml = t.seg ? '<div class="item">'+scopeDot(segMap[t.seg].scope)+segMap[t.seg].name+'</div>' : '<div class="item" style="color:var(--dim);">No segment — full user base</div>';
  detail.innerHTML = `
    <div class="tpl-detail-head">
      <div>
        <span class="industry-badge">${t.industry}</span>
        <h2 style="margin-top:8px;">${t.title}</h2>
        <p class="q">${t.q}</p>
      </div>
      <button class="tpl-close" onclick="closeTemplate()">Close ×</button>
    </div>
    <div class="tpl-blocks">
      <div class="tblock"><h4>Dimensions</h4>${dimsHtml}</div>
      <div class="tblock"><h4>Metrics</h4>${metsHtml}</div>
      <div class="tblock"><h4>Segment</h4>${segHtml}</div>
    </div>
    <div class="tpl-outcome"><h4>What this report actually tells you</h4><p>${t.outcome}</p></div>
    <div class="tpl-watch"><h4>Scope note</h4><p>${t.watch}</p></div>
    <div class="tpl-cta"><button onclick="loadIntoExplorer(${idx})">Load into Explore Combinations →</button></div>
  `;
  detail.scrollIntoView({behavior:'smooth', block:'nearest'});
}
function closeTemplate(){ document.getElementById('tplDetail').classList.remove('open'); }
function loadIntoExplorer(idx){
  const t = TEMPLATES[idx];
  selDims = t.dims.slice(0, LIMITS.dim);
  selMets = t.mets.slice(0, LIMITS.met);
  selSegs = t.seg ? [t.seg] : [];
  switchTab('explore');
  render();
  window.scrollTo({top:0, behavior:'smooth'});
}

function switchTab(name){
  document.querySelectorAll('.tab').forEach(el=>el.classList.toggle('active', el.dataset.tab===name));
  document.getElementById('view-explore').classList.toggle('active', name==='explore');
  document.getElementById('view-templates').classList.toggle('active', name==='templates');
}

renderIndustryNav();
